{
  "name": "@openquotestack/engine",
  "version": "0.2.0-alpha.1",
  "type": "module",
  "license": "AGPL-3.0-only",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm build && cp ../../LICENSE LICENSE"
  },
  "dependencies": {
    "@openquotestack/schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReVG08/OpenQuoteStack.git",
    "directory": "packages/engine"
  },
  "description": "Deterministic quote pricing with exact money arithmetic and explainable results.",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/ReVG08/OpenQuoteStack",
  "bugs": {
    "url": "https://github.com/ReVG08/OpenQuoteStack/issues"
  },
  "keywords": [
    "openquotestack",
    "pricing",
    "quotes",
    "self-hosted",
    "typescript"
