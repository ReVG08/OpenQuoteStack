{
  "name": "@openquotestack/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./services": "./src/services.ts",
    "./platform": "./src/platform.ts",
    "./worker": "./src/worker.ts",
