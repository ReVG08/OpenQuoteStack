{
  "name": "@openquotestack/sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api-types": {
      "types": "./dist/api-types.d.ts",
      "import": "./dist/api-types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm build && cp ../../LICENSE LICENSE"
  },
  "dependencies": {
    "@openquotestack/schema": "workspace:*",
    "@openquotestack/engine": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReVG08/OpenQuoteStack.git",
    "directory": "packages/sdk"
  }
