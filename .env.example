# Use unique credentials. Keep the local URL and PostgreSQL password consistent.
POSTGRES_USER=oqs
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_DB=oqs
DATABASE_URL=postgresql://oqs:replace-with-a-random-hex-password@127.0.0.1:5432/oqs
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional: an existing account to receive the moving-demo organization.
# SEED_OWNER_EMAIL=owner@example.com

# Optional writable filesystem directory for normalized brand images.
# Relative paths resolve against the web process working directory.
# Compose uses /app/data/assets with a persistent volume.
OQS_ASSET_DIR=.local/assets

# Install fictional data only when explicitly enabled against a development database.
SEED_DEMO=0

# Required for encrypting webhook signing secrets. Generate 32 random bytes as 64 hex characters.
OQS_ENCRYPTION_KEY=replace-with-64-random-hex-characters
# Close public account registration after creating your initial account, if desired.
OQS_DISABLE_REGISTRATION=false

# Brand assets: local (default) or s3. Keep this configuration identical on web and worker.
OQS_STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PREFIX=assets
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional SMTP. Port 587 requires STARTTLS; use SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Enable only for a trusted local relay or a development SMTP fixture.
SMTP_ALLOW_INSECURE=false

# Compose host ports. PostgreSQL and web bind to loopback by default.
OQS_WEB_PORT=3000
OQS_DB_PORT=5432

# Disable anonymous build-tool telemetry for direct CLI invocations.
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
